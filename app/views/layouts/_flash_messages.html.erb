<% if notice.present? %>
  <div role="alert" class="notice fixed top-4 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-lg border border-sullips-moss/40 bg-sullips-parchment/95 text-sullips-moss text-sm font-medium shadow-soft backdrop-blur-sm"><%= notice %></div>
<% end %>
<% if alert.present? %>
  <div role="alert" class="alert fixed top-4 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-lg border border-sullips-clay/40 bg-sullips-parchment/95 text-sullips-clay text-sm font-medium shadow-soft backdrop-blur-sm"><%= alert %></div>
<% end %>
