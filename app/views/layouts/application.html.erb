<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="font-sans bg-sullips-parchment min-h-screen antialiased">
    <%= render "layouts/flash_messages" %>

    <% if user_signed_in? %>
      <header class="bg-sullips-surface border-b border-sullips-border/80 shadow-soft">
        <div class="container mx-auto px-6 py-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <%= image_tag "logo.svg", alt: 'Jess Sullivan', class: "h-8 w-auto" %>
            <div class="flex flex-col leading-tight">
              <span class="text-sullips-logo font-medium text-xl tracking-tight">Jess Sullivan</span>
              <span class="text-sullips-muted text-xs tracking-wide hidden sm:block">Talks, trails & trusted care</span>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <%= button_to "Log out", destroy_user_session_path, method: :delete, data: { turbo: false },
                class: "px-4 py-2 rounded-md bg-sullips-moss hover:bg-sullips-pine text-sullips-parchment text-sm font-medium transition-all duration-200 cursor-pointer shadow-sullips hover:shadow-sullips active:scale-[0.99]" %>
            <%= link_to edit_account_path, class: "flex items-center justify-center w-9 h-9 rounded-full bg-sullips-moss hover:bg-sullips-pine transition-all duration-200 shadow-sullips", title: "Account settings" do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-sullips-parchment">
                <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" />
              </svg>
            <% end %>
          </div>
        </div>
      </header>
    <% end %>

    <main class="flex flex-col flex-1 min-h-screen">
      <%= yield %>
    </main>

    <% if user_signed_in? %>
      <footer class="bg-sullips-surface border-t border-sullips-border/80 mt-auto">
        <div class="container mx-auto px-6 py-8">
          <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="text-center md:text-left">
              <p class="text-sullips-text font-medium">Sullips Ltd</p>
              <p class="text-sullips-muted text-sm mt-1">Established January 2026</p>
            </div>
            <button type="button" onclick="return false;" 
                    class="px-6 py-2 rounded-md bg-sullips-moss hover:bg-sullips-pine text-sullips-parchment text-sm font-medium transition-all duration-200 cursor-pointer shadow-sullips hover:shadow-sullips active:scale-[0.99]">
              Contact Jess
            </button>
          </div>
        </div>
      </footer>
    <% end %>
  </body>
</html>
