<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="font-sans bg-sullips-parchment min-h-screen antialiased">
    <%= render "layouts/flash_messages" %>

    <% if user_signed_in? %>
      <header class="bg-sullips-surface border-b border-sullips-border/80 shadow-soft">
        <div class="container mx-auto px-6 py-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <%= image_tag "logo.svg", alt: "Sullips Ltd", class: "h-8 w-auto" %>
            <span class="text-sullips-logo font-medium text-xl tracking-[0.15em] uppercase">Sullips Ltd</span>
          </div>
          <%= button_to "Log out", destroy_user_session_path, method: :delete, data: { turbo: false },
              class: "px-4 py-2 rounded-md bg-sullips-moss hover:bg-sullips-pine text-sullips-parchment text-sm font-medium transition-all duration-200 cursor-pointer shadow-sullips hover:shadow-sullips active:scale-[0.99]" %>
        </div>
      </header>
    <% end %>

    <main class="flex flex-col flex-1 min-h-screen">
      <%= yield %>
    </main>

    <% if user_signed_in? %>
      <footer class="bg-sullips-surface border-t border-sullips-border/80 mt-auto">
        <div class="container mx-auto px-6 py-8">
          <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="text-center md:text-left">
              <p class="text-sullips-text font-medium">Sullips Ltd</p>
              <p class="text-sullips-muted text-sm mt-1">Established January 2026</p>
            </div>
            <button type="button" onclick="return false;" 
                    class="px-6 py-2 rounded-md bg-sullips-moss hover:bg-sullips-pine text-sullips-parchment text-sm font-medium transition-all duration-200 cursor-pointer shadow-sullips hover:shadow-sullips active:scale-[0.99]">
              Contact Jess
            </button>
          </div>
        </div>
      </footer>
    <% end %>
  </body>
</html>
