<div class="container mx-auto px-6 pt-6 pb-12">
  <div class="max-w-xl">
    <h2 class="text-2xl lg:text-3xl font-semibold text-sullips-text tracking-tight mb-2">Edit booking</h2>
    <p class="text-sullips-muted mb-8"><%= @order.product.title %></p>

    <%= render 'form', order: @order, submit_label: 'Save changes' %>

    <div class="mt-6">
      <%= link_to 'Back to booking', order_path(@order), class: 'text-sullips-muted hover:text-sullips-moss text-sm transition-colors border-b border-transparent hover:border-sullips-moss/30' %>
    </div>
  </div>
</div>
