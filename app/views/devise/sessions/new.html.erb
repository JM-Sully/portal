<h2 class="text-2xl lg:text-3xl font-semibold text-sullips-text tracking-tight mb-8">Log in to your account</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-sullips-text mb-1.5 tracking-wide" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
        class: "form-input-auth" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-sullips-text mb-1.5 tracking-wide" %>
    <%= f.password_field :password, autocomplete: "current-password",
        class: "form-input-auth" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :remember_me, class: "rounded border-sullips-border accent-sullips-moss focus:ring-sullips-moss" %>
      <%= f.label :remember_me, class: "text-sm text-sullips-text" %>
    </div>
  <% end %>

  <div class="pt-2">
    <%= f.submit "Log in",
        class: "form-submit-auth" %>
  </div>
<% end %>

<div class="mt-8 pt-8 border-t border-sullips-border/60">
  <%= render "devise/shared/links" %>
</div>
