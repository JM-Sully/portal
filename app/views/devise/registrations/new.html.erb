<h2 class="text-2xl lg:text-3xl font-semibold text-sullips-text tracking-tight mb-8">Create your account</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-sullips-text mb-1.5 tracking-wide" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
        class: "form-input-auth" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-sullips-text mb-1.5 tracking-wide" %>
    <% if @minimum_password_length %>
      <span class="text-sullips-muted text-sm">(<%= @minimum_password_length %> characters minimum)</span>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password",
        class: "form-input-auth mt-1" %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-sullips-text mb-1.5 tracking-wide" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
        class: "form-input-auth" %>
  </div>

  <div class="pt-2">
    <%= f.submit "Sign up",
        class: "form-submit-auth" %>
  </div>
<% end %>

<div class="mt-8 pt-8 border-t border-sullips-border/60">
  <%= render "devise/shared/links" %>
</div>
