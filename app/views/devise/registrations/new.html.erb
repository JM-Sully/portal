<h2 class="text-2xl lg:text-3xl font-semibold text-sullips-text tracking-tight mb-8">Create your account</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
  <%= render 'devise/registrations/form', f: f, button_text: 'Sign up' %>
<% end %>

<div class="mt-8 pt-8 border-t border-sullips-border/60">
  <%= render "devise/shared/links" %>
</div>
