<h2 class="text-2xl lg:text-3xl font-semibold text-sullips-text tracking-tight mb-8">Change your password</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
  <% if resource.errors.any? %>
    <%= render "devise/shared/error_messages", resource: resource %>
  <% end %>
  <%= f.hidden_field :reset_password_token %>

  <div>
    <%= f.label :password, "New password", class: "block text-sm font-medium text-sullips-text mb-1.5 tracking-wide" %>
    <% if @minimum_password_length %>
      <span class="text-sullips-muted text-sm">(<%= @minimum_password_length %> characters minimum)</span>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
        class: "form-input-auth mt-1" %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-sullips-text mb-1.5 tracking-wide" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
        class: "form-input-auth" %>
  </div>

  <div class="pt-2">
    <%= f.submit "Change my password",
        class: "form-submit-auth" %>
  </div>
<% end %>

<div class="mt-8 pt-8 border-t border-sullips-border/60">
  <%= render "devise/shared/links" %>
</div>
