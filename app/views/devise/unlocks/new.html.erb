<h2 class="text-2xl lg:text-3xl font-semibold text-sullips-text tracking-tight mb-8">Resend unlock instructions</h2>

<%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-sullips-text mb-1.5 tracking-wide" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
        class: "form-input-auth" %>
  </div>

  <div class="pt-2">
    <%= f.submit "Resend unlock instructions", class: "form-submit-auth" %>
  </div>
<% end %>

<div class="mt-8 pt-8 border-t border-sullips-border/60">
  <%= render "devise/shared/links" %>
</div>
